# Copy this file to config/grn_export.env and fill one access method.
# Do not commit config/grn_export.env to GitHub.

# Output consumed by the Streamlit sidebar when "Use live Superset GRN" is on.
GRN_OUTPUT_CSV=data/live/grn_live.csv
# Use sql/mseg_grn_with_mkpf_export.sql when dataplatform.mkpf is available
# so the live CSV includes grn_date and SAP entry timestamps.
GRN_SQL_FILE=sql/mseg_grn_with_mkpf_export.sql

# Preferred method: query Trino directly with read-only credentials.
# Ask your data/Superset admin for these values. The Superset database label
# "Data-analyst-trino" is not always the same as the direct Trino host.
GRN_EXPORT_SOURCE=trino
TRINO_HOST=
TRINO_PORT=443
TRINO_HTTP_SCHEME=https
TRINO_SSL_VERIFY=true
TRINO_USER=
TRINO_AUTH=basic
TRINO_PASSWORD=
TRINO_CATALOG=
TRINO_SCHEMA=

# Alternative method: Superset SQL Lab API.
# Use this only if your Superset instance supports API login for a service account.
# GRN_EXPORT_SOURCE=superset_api
SUPERSET_BASE_URL=http://superset.corp.olaelectric.com
SUPERSET_DATABASE_ID=
SUPERSET_DATABASE_NAME=Data-analyst-trino
SUPERSET_USERNAME=
SUPERSET_PASSWORD=
SUPERSET_PROVIDER=ldap
SUPERSET_SCHEMA=
SUPERSET_QUERY_LIMIT=50000
SUPERSET_VERIFY_SSL=true
